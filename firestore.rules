rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function builder() {
   return request.auth != null && request.auth.token.email_verified == true && request.auth.token.email.lower() in ['recruiting@rebelssoftball.org','chrisolsen@finditds.com','halley.rindom@gmail.com','dmayhugh425511@gmail.com'];
  }
  // A portal URL is a bearer link with a cryptographically random 256-bit ID.
  // Individual get is allowed; listing the directory is never allowed.
  match /rpPortals/{token} {
   allow get: if token.matches('^[a-f0-9]{64}$');
   allow list: if false;
   allow create, update: if builder() && token.matches('^[a-f0-9]{64}$');
   allow delete: if false;
  }
  match /rpClocks/{token} {
   allow get: if token.matches('^[a-f0-9]{64}$');
   allow list: if false;
   allow create, update: if builder() && token.matches('^[a-f0-9]{64}$');
   allow delete: if false;
  }
  match /rpTeams/{team} {
   allow get, create, update: if builder();
   allow list, delete: if false;
  }
 }
}
