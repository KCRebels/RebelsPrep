rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function builder() { return request.auth != null && request.auth.token.email_verified == true; }
  match /rpPortals/{token} {
   allow get: if token.matches('^[a-f0-9]{64}$');
   allow list, delete: if false;
   allow create, update: if builder();
  }
  match /rpClocks/{token} {
   allow get: if token.matches('^[a-f0-9]{64}$');
   allow list, delete: if false;
   allow create, update: if builder();
  }
  match /rpTeams/{team} {
   allow get, create, update: if builder();
   allow list, delete: if false;
  }
  match /rpCheckinSessions/{token} {
   allow get: if token.matches('^[a-f0-9]{64}$');
   allow list, delete: if false;
   allow create, update: if builder();
  }
  match /rpCheckins/{id} {
   allow create: if request.resource.data.kind in ['player','guest-request']
    && request.resource.data.status in ['checked-in','pending']
    && request.resource.data.name is string
    && request.resource.data.practiceTime is string;
   allow get, list, update: if builder();
   allow delete: if false;
  }
 }
}