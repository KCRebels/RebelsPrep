rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function builder() { return request.auth != null && request.auth.token.email_verified == true && request.auth.token.email in ['Recruiting@rebelssoftball.org','recruiting@rebelssoftball.org','chrisolsen@finditds.com','halley.rindom@gmail.com','dmayhugh425511@gmail.com']; }
  function sessionPath() { return /databases/$(database)/documents/rpCheckinSessions/$(request.resource.data.sessionToken); }
  function clockPath() { return /databases/$(database)/documents/rpClocks/$(request.resource.data.clockToken); }
  function validSession() { return request.resource.data.practiceTime is string && request.resource.data.practiceDate is string && request.resource.data.sessionToken is string && request.resource.data.clockToken is string && request.resource.data.clockToken.matches('^[a-f0-9]{64}$') && request.resource.data.facility in ['barn','shed'] && request.resource.data.practiceTime.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$') && request.resource.data.practiceDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') && request.resource.data.sessionToken.matches('^[a-f0-9]{64}$') && exists(sessionPath()) && get(sessionPath()).data.active == true && get(sessionPath()).data.clockToken == request.resource.data.clockToken && get(sessionPath()).data.date == request.resource.data.practiceDate && get(sessionPath()).data.start == request.resource.data.practiceTime && get(sessionPath()).data.facility == request.resource.data.facility && exists(clockPath()) && get(clockPath()).data.clock.done != true; }
  function validPlayer() { return request.resource.data.playerId is string && request.resource.data.playerId in get(sessionPath()).data.playerIds && request.resource.data.name == get(sessionPath()).data.playerNames[request.resource.data.playerId] && request.resource.data.teamId is string && request.resource.data.teamId in get(sessionPath()).data.teamIds && request.resource.data.teamIds is list && request.resource.data.teamIds.size() > 0 && request.resource.data.teamIds.size() <= get(sessionPath()).data.teamIds.size() && request.resource.data.teamIds.toSet().hasOnly(get(sessionPath()).data.teamIds.toSet()); }
  function playerFields() { return request.resource.data.keys().hasOnly(['kind','playerId','name','sessionToken','clockToken','teamId','teamIds','practiceTime','practiceDate','facility','createdAt','status']); }
  function guestFields() { return request.resource.data.keys().hasOnly(['kind','name','practiceTime','practiceDate','facility','sessionToken','sessionTokens','clockToken','clockTokens','createdAt','status']); }
  function validGuest() { return request.resource.data.name is string && request.resource.data.sessionTokens is list && request.resource.data.clockTokens is list && request.resource.data.sessionTokens.size() > 0 && request.resource.data.clockTokens.size() > 0 && request.resource.data.sessionTokens.size() == request.resource.data.clockTokens.size() && request.resource.data.sessionTokens.size() <= 10 && request.resource.data.clockTokens.size() <= 10 && request.resource.data.sessionToken in request.resource.data.sessionTokens && request.resource.data.clockToken in request.resource.data.clockTokens && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 100; }
  function samePublicCheckin() { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['createdAt']) && request.resource.data.createdAt == request.time; }

  // Permanent account model. The hard-coded builder allowlist above is migration/bootstrap only.
  function signedIn() { return request.auth != null; }
  function accountPath() { return /databases/$(database)/documents/rpAccounts/$(request.auth.uid); }
  function hasAccount() { return signedIn() && exists(accountPath()); }
  function account() { return get(accountPath()).data; }
  function orgCoach() { return hasAccount() && account().active == true && account().role in ['org_admin','org_coach']; }
  function teamCoach(teamId) { return hasAccount() && account().active == true && account().role == 'team_coach' && account().teamIds is list && teamId in account().teamIds; }
  function coachFor(teamId) { return orgCoach() || teamCoach(teamId); }
  function ownPlayer(playerId) { return hasAccount() && account().active == true && account().role == 'player' && account().playerId == playerId; }
  function playerOnTeam(teamId) { return hasAccount() && account().active == true && account().role == 'player' && account().teamIds is list && teamId in account().teamIds; }
  function validAccountRole() { return request.resource.data.role in ['org_admin','org_coach','team_coach','player']; }
  function eligiblePlayerAccount() { return request.resource.data.role != 'player' || (request.resource.data.playerId is string && exists(/databases/$(database)/documents/rpPlayers/$(request.resource.data.playerId)) && get(/databases/$(database)/documents/rpPlayers/$(request.resource.data.playerId)).data.playerPortalEnabled == true); }
  function accountSelfFields() { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName','lastSeenAt']); }
  match /rpSystem/{document} {
   allow get: if builder() || orgCoach();
   allow list, delete: if false;
   allow create, update: if builder() || orgCoach();
  }
  match /rpAccounts/{uid} {
   allow get: if signedIn() && (request.auth.uid == uid || orgCoach());
   allow list: if orgCoach();
   // During migration only an existing legacy builder can provision identities/permissions.
   allow create: if builder() && validAccountRole() && eligiblePlayerAccount();
   allow delete: if builder();
   allow update: if (builder() && validAccountRole() && eligiblePlayerAccount()) || (signedIn() && request.auth.uid == uid && accountSelfFields());
  }
  match /rpDirectoryTeams/{teamId} {
   allow get: if hasAccount() && (orgCoach() || teamCoach(teamId) || playerOnTeam(teamId));
   allow list: if orgCoach();
   allow create, update: if builder() || orgCoach();
   allow delete: if false;
  }
  match /rpPlayers/{playerId} {
   allow get: if ownPlayer(playerId) || orgCoach() || (hasAccount() && account().active == true && account().role == 'team_coach' && resource.data.teamIds is list && account().teamIds is list && account().teamIds.toSet().hasAny(resource.data.teamIds.toSet()));
   allow list: if orgCoach();
   allow create, update: if builder() || orgCoach();
   allow delete: if false;
   match /private/{document=**} {
    allow read: if ownPlayer(playerId) || orgCoach();
    allow write: if orgCoach();
   }
  }
  match /rpPractices/{practiceId} {
   allow read: if orgCoach() || coachFor(resource.data.teamId) || playerOnTeam(resource.data.teamId);
   allow create: if builder() || coachFor(request.resource.data.teamId);
   allow update: if builder() || coachFor(resource.data.teamId);
   allow delete: if false;
   match /assignments/{playerId} {
    allow read: if ownPlayer(playerId) || orgCoach() || coachFor(resource.data.teamId);
    allow create, update: if builder() || coachFor(request.resource.data.teamId);
    allow delete: if false;
   }
  }
  match /rpFeedback/{feedbackId} {
   allow read: if ownPlayer(resource.data.playerId) || orgCoach() || coachFor(resource.data.teamId);
   allow create: if coachFor(request.resource.data.teamId)
    && request.resource.data.authorUid == request.auth.uid
    && request.resource.data.authorCoachId is string
    && request.resource.data.authorName is string
    && request.resource.data.playerId is string;
   allow update: if coachFor(resource.data.teamId)
    && request.resource.data.authorUid == resource.data.authorUid
    && request.resource.data.authorCoachId == resource.data.authorCoachId
    && request.resource.data.authorName == resource.data.authorName
    && request.resource.data.playerId == resource.data.playerId
    && request.resource.data.teamId == resource.data.teamId;
   allow delete: if orgCoach();
  }
  match /rpFacilities/{facilityId} {
   allow get, list: if hasAccount();
   allow create, update: if builder() || orgCoach();
   allow delete: if false;
  }
  match /rpAccountCheckins/{checkinId} {
   allow read: if hasAccount() && (resource.data.uid == request.auth.uid || orgCoach() || coachFor(resource.data.teamId));
   allow create: if hasAccount()
    && account().role == 'player'
    && request.resource.data.uid == request.auth.uid
    && request.resource.data.playerId == account().playerId
    && playerOnTeam(request.resource.data.teamId)
    && request.resource.data.facilityId is string
    && request.resource.data.practiceId is string
    && request.resource.data.createdAt == request.time;
   allow update: if orgCoach() || coachFor(resource.data.teamId);
   allow delete: if false;
  }

  // Legacy compatibility collections remain until authenticated accounts replace them.
  match /rpPortals/{token} { allow get: if token.matches('^[a-f0-9]{64}$'); allow list, delete: if false; allow create, update: if builder(); }
  match /rpClocks/{token} { allow get: if token.matches('^[a-f0-9]{64}$'); allow list, delete: if false; allow create, update: if builder(); }
  match /rpTeams/{team} { allow get, create, update: if builder(); allow list, delete: if false; }
  match /rpCheckinSessions/{token} { allow get: if token.matches('^[a-f0-9]{64}$'); allow list: if builder(); allow delete: if false; allow create, update: if builder(); }
  match /rpCheckinLocations/{location} { allow get: if location in ['barn','shed']; allow list, delete: if false; allow create, update: if builder(); }
  match /rpCheckins/{id} {
   allow create: if request.resource.data.createdAt == request.time && request.resource.data.name is string && request.resource.data.practiceTime is string && request.resource.data.practiceDate is string && validSession() && ((request.resource.data.kind == 'player' && request.resource.data.status == 'checked-in' && playerFields() && validPlayer()) || (request.resource.data.kind == 'guest-request' && request.resource.data.status == 'pending' && guestFields() && validGuest()));
   allow get, list: if builder();
   allow update: if builder() || (resource.data.kind == 'player' && resource.data.status == 'checked-in' && request.resource.data.kind == 'player' && request.resource.data.status == 'checked-in' && playerFields() && validSession() && validPlayer() && samePublicCheckin()) || (resource.data.kind == 'guest-request' && resource.data.status == 'pending' && request.resource.data.kind == 'guest-request' && request.resource.data.status == 'pending' && guestFields() && validSession() && validGuest() && samePublicCheckin());
   allow delete: if false;
  }
 }
}
