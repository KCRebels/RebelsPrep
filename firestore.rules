rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function builder() { return request.auth != null && request.auth.token.email_verified == true && request.auth.token.email in ['Recruiting@rebelssoftball.org','recruiting@rebelssoftball.org','chrisolsen@finditds.com','halley.rindom@gmail.com','dmayhugh425511@gmail.com']; }
  function validSession() { return request.resource.data.sessionToken is string && request.resource.data.sessionToken.matches('^[a-f0-9]{64}
  match /rpPortals/{token} { allow get: if token.matches('^[a-f0-9]{64}$'); allow list, delete: if false; allow create, update: if builder(); }
  match /rpClocks/{token} { allow get: if token.matches('^[a-f0-9]{64}$'); allow list, delete: if false; allow create, update: if builder(); }
  match /rpTeams/{team} { allow get, create, update: if builder(); allow list, delete: if false; }
  match /rpCheckinSessions/{token} { allow get: if token.matches('^[a-f0-9]{64}$'); allow list, delete: if false; allow create, update: if builder(); }
  match /rpCheckinLocations/{location} { allow get: if location in ['barn','shed']; allow list, delete: if false; allow create, update: if builder(); }
  match /rpCheckins/{id} { allow create: if request.resource.data.keys().hasOnly(['kind','playerId','name','sessionToken','clockToken','teamId','teamIds','practiceTime','practiceDate','facility','createdAt','status']) && ((request.resource.data.kind == 'player' && request.resource.data.status == 'checked-in' && validPlayer()) || (request.resource.data.kind == 'guest-request' && request.resource.data.status == 'pending' && request.resource.data.keys().hasOnly(['kind','name','practiceTime','practiceDate','facility','sessionToken','sessionTokens','clockToken','clockTokens','createdAt','status']))) && request.resource.data.name is string && request.resource.data.practiceTime is string && request.resource.data.practiceDate is string && validSession(); allow get, list, update: if builder(); allow delete: if false; }
 }
}) && exists(/databases/$(database)/documents/rpCheckinSessions/$(request.resource.data.sessionToken)) && get(/databases/$(database)/documents/rpCheckinSessions/$(request.resource.data.sessionToken)).data.active == true && get(/databases/$(database)/documents/rpCheckinSessions/$(request.resource.data.sessionToken)).data.clockToken == request.resource.data.clockToken && get(/databases/$(database)/documents/rpCheckinSessions/$(request.resource.data.sessionToken)).data.date == request.resource.data.practiceDate && get(/databases/$(database)/documents/rpCheckinSessions/$(request.resource.data.sessionToken)).data.start == request.resource.data.practiceTime; }
  function validPlayer() { return request.resource.data.playerId is string && request.resource.data.playerId in get(/databases/$(database)/documents/rpCheckinSessions/$(request.resource.data.sessionToken)).data.playerIds && request.resource.data.name == get(/databases/$(database)/documents/rpCheckinSessions/$(request.resource.data.sessionToken)).data.playerNames[request.resource.data.playerId]; }
  match /rpPortals/{token} { allow get: if token.matches('^[a-f0-9]{64}$'); allow list, delete: if false; allow create, update: if builder(); }
  match /rpClocks/{token} { allow get: if token.matches('^[a-f0-9]{64}$'); allow list, delete: if false; allow create, update: if builder(); }
  match /rpTeams/{team} { allow get, create, update: if builder(); allow list, delete: if false; }
  match /rpCheckinSessions/{token} { allow get: if token.matches('^[a-f0-9]{64}$'); allow list, delete: if false; allow create, update: if builder(); }
  match /rpCheckinLocations/{location} { allow get: if location in ['barn','shed']; allow list, delete: if false; allow create, update: if builder(); }
  match /rpCheckins/{id} { allow create: if ((request.resource.data.kind == 'player' && request.resource.data.status == 'checked-in') || (request.resource.data.kind == 'guest-request' && request.resource.data.status == 'pending')) && request.resource.data.name is string && request.resource.data.practiceTime is string && request.resource.data.practiceDate is string && validSession(); allow get, list, update: if builder(); allow delete: if false; }
 }
}